# Скопировать в .env и заполнить.
# .env в .gitignore — реальные ключи никогда не коммитятся.

# === LiteLLM ===
LITELLM_URL=http://5.2.66.188:4000
LITELLM_KEY=sk-...

# === HTTP/HTTPS прокси (для RU-серверов, к недоступным сервисам) ===
HTTPS_PROXY=http://user:pass@host:8888
HTTP_PROXY=http://user:pass@host:8888
NO_PROXY=localhost,127.0.0.1,::1

# === fal.ai ===
FAL_KEY=

# === Apify ===
APIFY_TOKEN=
APIFY_USER_ID=

# === VK API ===
VK_SERVICE_TOKEN=

# === GitHub PAT ===
GITHUB_PAT=

# === Telegram бот (входная точка OpenClaw) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=
# Обязательно: user_id оператора. OpenClaw использует его как groupAllowFrom —
# без этого ВСЕ сообщения в группе silent-drop'аются (allowlist semantics).
# Узнать: getChatAdministrators по группе или tools/get-tg-chat-id.mjs.
TELEGRAM_OWNER_ID=

# Auth-токен для OpenClaw gateway (loopback). 24+ байта hex.
# Сгенерировать: openssl rand -hex 24
OPENCLAW_GATEWAY_TOKEN=

# === S3 (Timeweb Cloud) ===
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# === Swift (Timeweb Cloud) ===
SWIFT_URL=https://swift.twcstorage.ru
SWIFT_ACCESS_KEY=
SWIFT_SECRET_KEY=
