# Скопировать в .env и заполнить. .env в .gitignore — реальные ключи не коммитятся.
# Полная инструкция по кредам — docs/access-setup.md.

# === Notion (операционка: базы Клиенты/Планы/Посты) ===
# Internal Integration Secret. ID баз — НЕ здесь, а открыто в config/notion.json.
NOTION_TOKEN=ntn_...

# === Google Drive (медиа, service-account) ===
# JSON-ключ положить в корень репо (gitignored), путь — сюда:
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GDRIVE_ROOT_FOLDER_ID=

# === fal.ai (генерация картинок/видео) ===
FAL_KEY=

# === Apify (парсинг конкурентов) ===
APIFY_TOKEN=
APIFY_USER_ID=

# === VK API ===
VK_SERVICE_TOKEN=

# === GitHub PAT ===
GITHUB_PAT=

# === S3 (Timeweb Cloud) — медиа сейчас + архив сессий ===
S3_ENDPOINT=https://s3.twcstorage.ru
S3_BUCKET=
S3_REGION=ru-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# === Swift (Timeweb Cloud) ===
SWIFT_URL=https://swift.twcstorage.ru
SWIFT_ACCESS_KEY=
SWIFT_SECRET_KEY=

# === LiteLLM (только для spend-отчётов; в горячем пути НЕ используется) ===
LITELLM_URL=http://5.2.66.188:4000
LITELLM_KEY=sk-...

# === Прокси: нужен ТОЛЬКО для запусков с RU-сервера. Локальный Claude Code — без прокси. ===
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
