# Шаблон env для шлюза. На сервере лежит /opt/chatwoot/gateway.env (chmod 600, не в git).
CHATWOOT_URL=http://rails:3000
CHATWOOT_VK_INBOX_IDENTIFIER=<identifier API-канала VK из Chatwoot>
CHATWOOT_TG_INBOX_IDENTIFIER=<identifier API-канала Telegram из Chatwoot>
VK_COMMUNITY_TOKEN=<токен сообщества VK>
VK_GROUP_ID=<id сообщества>
TELEGRAM_BOT_TOKEN=<токен бота BotFather>
PROXY_URL=http://<user>:<pass>@5.2.66.188:8888
HTTP_PROXY=http://<user>:<pass>@5.2.66.188:8888
HTTPS_PROXY=http://<user>:<pass>@5.2.66.188:8888
NO_PROXY=rails,redis,postgres,localhost,127.0.0.1,api.vk.com,.vk.com
STATE_PATH=/data/state.json
